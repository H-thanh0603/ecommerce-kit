DATABASE_URL="file:./dev.db"
# Postgres (Neon/Supabase/docker compose profile pg) — xem DEPLOY.md để chuyển provider:
# DATABASE_URL="postgresql://ek:ek@localhost:5432/ek?schema=public"
AUTH_SECRET="doi-thanh-chuoi-ngau-nhien-khi-clone"
ADMIN_EMAIL="admin@atelier.vn"
ADMIN_PASSWORD="admin123"
APP_URL="http://localhost:3000"
# Chatbot + AI Agent (SpaceXAI / xAI). Để trống thì UI vẫn hiện, API trả hướng dẫn cấu hình.
XAI_API_KEY=
# VNPay sandbox — bật site.payments.vnpay.enabled
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# GHN — bật features.ghn
GHN_TOKEN=
GHN_SHOP_ID=
# SMTP gửi mail thật (không cấu hình thì mail chỉ ghi DB xem ở admin). VD Gmail App Password / Resend SMTP.
SMTP_HOST=
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Upload ảnh: local mặc định (VPS nhớ mount volume). Vercel/R2/S3 thì điền 6 dòng dưới.
UPLOAD_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION="auto"
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=
# MoMo sandbox — bật site.payments.momo.enabled
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_URL="https://test-payment.momo.vn/v2/gateway/api/create"
# Rate-limit Redis (Upstash REST) cho nhiều replica — không có thì dùng memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# SePay đối soát CK tự động — webhook https://domain/api/payments/sepay/webhook
SEPAY_API_KEY=
