generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  role         String             @default("customer")
  orders       Order[]
  reviews      Review[]
  cartLines    CartLine[]
  wishlist     WishlistItem[]
  redemptions  CouponRedemption[]
  resets       PasswordReset[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  image       String    @default("")
  products    Product[]
}

model Product {
  id                String          @id
  slug              String          @unique
  name              String
  subtitle          String          @default("")
  description       String
  price             Int
  compareAtPrice    Int?
  tags              String          @default("")
  optionsJson       String          @default("[]")
  rating            Float           @default(0)
  reviewCount       Int             @default(0)
  stock             Int             @default(0)
  sold              Int             @default(0)
  featured          Boolean         @default(false)
  flashSale         Boolean         @default(false)
  flashSaleStartsAt DateTime?
  flashSaleEndsAt   DateTime?
  published         Boolean         @default(true)
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  skus              Sku[]
  reviews           Review[]
  orderItems        OrderItem[]
  cartLines         CartLine[]
  wishlist          WishlistItem[]
  stockMoves        StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([categoryId])
  @@index([published, featured])
  @@index([slug])
  @@index([name])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sort      Int     @default(0)

  @@index([productId, sort])
}

model Sku {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  stock      Int         @default(0)
  orderItems OrderItem[]
  cartLines  CartLine[]
  stockMoves StockMovement[]

  @@unique([productId, label])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  author    String
  rating    Int
  content   String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  type           String
  value          Int
  minOrder       Int                @default(0)
  active         Boolean            @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  maxUses        Int?
  maxUsesPerUser Int?
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  orderId   String
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([email])
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  seq           Int         @unique
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customer      String
  email         String
  phone         String
  address       String
  innerCity     Boolean     @default(false)
  note          String      @default("")
  subtotal      Int
  shippingFee   Int
  discount      Int         @default(0)
  total         Int
  paymentMethod String
  paymentStatus String      @default("unpaid")
  status        String      @default("pending")
  couponCode    String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([email])
  @@index([status, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  skuId        String?
  sku          Sku?    @relation(fields: [skuId], references: [id])
  slug         String
  name         String
  image        String
  price        Int
  quantity     Int
  variantLabel String  @default("")

  @@index([orderId])
}

model Article {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String
  cover   String
  body    String @default("")
  date    String
  minutes Int    @default(3)
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model CartLine {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuId        String?
  sku          Sku?    @relation(fields: [skuId], references: [id])
  quantity     Int
  variantLabel String  @default("")

  @@unique([userId, productId, variantLabel])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuId     String?
  sku       Sku?     @relation(fields: [skuId], references: [id])
  delta     Int
  reason    String
  ref       String   @default("")
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model OrderCounter {
  id    String @id
  value Int    @default(0)
}
