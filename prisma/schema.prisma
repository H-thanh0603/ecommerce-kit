generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  role         String             @default("customer")
  /// Bump khi đổi mật khẩu / reset — JWT cũ mang tv cũ bị từ chối (revoke).
  tokenVersion Int                @default(0)
  mfaEnabled   Boolean            @default(false)
  /// TOTP secret base32 — chỉ admin đã bật MFA mới có giá trị.
  mfaSecret    String             @default("")
  /// JSON array recovery code đã bcrypt — backup khi mất thiết bị.
  mfaRecovery  String             @default("[]")
  orders       Order[]
  reviews      Review[]
  cartLines    CartLine[]
  wishlist     WishlistItem[]
  addresses    Address[]
  redemptions  CouponRedemption[]
  resets       PasswordReset[]
  bookings     Booking[]
  points       Int                @default(0)
  memberTier   String             @default("dong")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  image       String    @default("")
  products    Product[]
}

model Product {
  id                String          @id
  slug              String          @unique
  name              String
  subtitle          String          @default("")
  description       String
  searchText        String          @default("")
  price             Int
  compareAtPrice    Int?
  tags              String          @default("")
  optionsJson       String          @default("[]")
  attrsJson         String          @default("{}")
  rating            Float           @default(0)
  reviewCount       Int             @default(0)
  stock             Int             @default(0)
  sold              Int             @default(0)
  featured          Boolean         @default(false)
  flashSale         Boolean         @default(false)
  flashSaleStartsAt DateTime?
  flashSaleEndsAt   DateTime?
  published         Boolean         @default(true)
  unit              String          @default("cai")
  weightGrams       Int             @default(500)
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  skus              Sku[]
  reviews           Review[]
  orderItems        OrderItem[]
  cartLines         CartLine[]
  wishlist          WishlistItem[]
  stockMoves        StockMovement[]
  warehouseStocks   WarehouseStock[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([categoryId])
  @@index([published, featured])
  @@index([slug])
  @@index([name])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sort      Int     @default(0)

  @@index([productId, sort])
}

model Sku {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  stock      Int         @default(0)
  orderItems OrderItem[]
  cartLines  CartLine[]
  stockMoves StockMovement[]

  @@unique([productId, label])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  author    String
  rating    Int
  content   String
  status    String   @default("approved")
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  type           String
  value          Int
  minOrder       Int                @default(0)
  active         Boolean            @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  maxUses        Int?
  maxUsesPerUser Int?
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  orderId   String
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([email])
}

model GiftCard {
  id          String            @id @default(cuid())
  code        String            @unique
  balance     Int
  active      Boolean           @default(true)
  note        String            @default("")
  expiresAt   DateTime?
  redemptions GiftRedemption[]
  createdAt   DateTime          @default(now())
}

model GiftRedemption {
  id        String   @id @default(cuid())
  giftId    String
  gift      GiftCard @relation(fields: [giftId], references: [id], onDelete: Cascade)
  orderId   String
  amount    Int
  createdAt DateTime @default(now())

  @@index([giftId])
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemsJson String   @default("[]")
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([orderId, status])
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  method    String   @default("bank")
  status    String   @default("pending")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([orderId, status])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  message   String
  /// Email/id người thao tác (admin) — truy vết ai đổi trạng thái / hoàn tiền.
  actor     String   @default("")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    String   @default("order.created,order.status,order.paid")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Bundle {
  id        String   @id @default(cuid())
  name      String
  linesJson String   @default("[]")
  price     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  seq           Int         @unique
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customer      String
  email         String
  phone         String
  address       String
  innerCity     Boolean     @default(false)
  note          String      @default("")
  subtotal      Int
  shippingFee   Int
  discount      Int         @default(0)
  total         Int
  paymentMethod String
  paymentStatus String      @default("unpaid")
  paymentRef    String      @default("")
  status        String      @default("pending")
  couponCode    String?
  bundleCode    String   @default("")
  warehouseId   String?
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id])
  ghnOrderCode  String      @default("")
  pointsUsed    Int         @default(0)
  pointsEarned  Int         @default(0)
  /// Idempotency key phía client — double-POST tạo 1 đơn (unique).
  clientRequestId String?
  items         OrderItem[]
  invoice       Invoice?
  returns       ReturnRequest[]
  refunds       Refund[]
  events        OrderEvent[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([clientRequestId])
  @@index([email])
  @@index([status, createdAt])
  @@index([userId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  skuId        String?
  sku          Sku?    @relation(fields: [skuId], references: [id])
  slug         String
  name         String
  image        String
  price        Int
  quantity     Int
  variantLabel String  @default("")

  @@index([orderId])
}

model Article {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String
  cover   String
  body    String @default("")
  date    String
  minutes Int    @default(3)
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model CartLine {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuId        String?
  sku          Sku?     @relation(fields: [skuId], references: [id])
  quantity     Int
  variantLabel String   @default("")
  updatedAt    DateTime @updatedAt

  @@unique([userId, productId, variantLabel])
  @@index([updatedAt])
  @@index([userId, updatedAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Nhà")
  name      String
  phone     String
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuId     String?
  sku       Sku?     @relation(fields: [skuId], references: [id])
  delta     Int
  reason    String
  ref       String   @default("")
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, used, expiresAt])
  @@index([createdAt])
}

model MailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  status    String   @default("logged")
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@index([createdAt])
}

model OrderCounter {
  id    String @id
  value Int    @default(0)
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  buyerName String
  buyerTax  String   @default("")
  buyerAddress String @default("")
  taxRate   Int      @default(10)
  vatAmount Int      @default(0)
  issuedAt  DateTime @default(now())
}

model Warehouse {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  address   String           @default("")
  isDefault Boolean          @default(false)
  stocks    WarehouseStock[]
  orders    Order[]
}

model WarehouseStock {
  id          String     @id @default(cuid())
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuKey      String     @default("")
  stock       Int        @default(0)

  @@unique([warehouseId, productId, skuKey])
}

model BookingService {
  id          String    @id @default(cuid())
  name        String
  durationMin Int       @default(60)
  price       Int
  active      Boolean   @default(true)
  bookings    Booking[]
}

model Booking {
  id        String         @id @default(cuid())
  serviceId String
  service   BookingService @relation(fields: [serviceId], references: [id])
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
  name      String
  email     String
  phone     String
  startsAt  DateTime
  note      String         @default("")
  status    String         @default("pending")
  createdAt DateTime       @default(now())

  @@index([startsAt])
  @@index([status, createdAt])
  @@index([email])
}

/**
 * Ghi đè cấu hình site theo DB — ưu tiên hơn `src/config/site.ts` (file chỉ còn là default).
 * key: "brand" | "theme" | "shipping" | "features", value: JSON string.
 * Sửa trên trang /admin/cai-dat, áp dụng ngay không cần rebuild.
 */
model SiteSetting {
  key       String   @id
  value     String   @default("{}")
  updatedAt DateTime @updatedAt
}

/**
 * Nhật ký thao tác nhạy cảm của admin (Q148): đổi cài đặt, hoàn tiền,
 * duyệt đơn, CRUD sản phẩm/khuyến mãi — ai, làm gì, trước/sau.
 */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @default("")
  actorEmail String   @default("")
  action     String
  entity     String   @default("")
  entityId   String   @default("")
  before     String   @default("")
  after      String   @default("")
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@index([action, createdAt])
}
